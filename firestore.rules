// firestore.rules — regras para o banco do site Registros.
//
// ESTE ARQUIVO É SÓ PARA VOCÊ COPIAR: nada foi publicado.
// Console do Firebase > Firestore Database > aba Regras > cole tudo > Publicar.
//
// O que estas regras fazem:
//  - só existem as coleções "registros" e "acesso"; qualquer outra coisa fica bloqueada;
//  - "acesso/senha" guarda a senha única do site já transformada em hash (nunca a senha em texto):
//    pode ser lida e criada UMA vez; trocar e apagar são bloqueados (para trocar a senha, apague
//    o documento pelo console do Firebase, que ignora estas regras);
//  - cada registro precisa ter exatamente os 7 campos esperados, com tipo e tamanho certos
//    (assim ninguém grava lixo nem textos enormes);
//  - ler, gravar e apagar não exigem login.
//
// ATENÇÃO: sem login, quem descobrir o endereço do site consegue ler e apagar os registros.
// Não guarde nada sensível aqui.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function textoAte(d, campo, max) {
      return d[campo] is string && d[campo].size() <= max;
    }

    function registroValido(d) {
      return d.keys().hasOnly(['nome', 'projeto', 'horario', 'data', 'estado', 'obs', 'ordem'])
        && d.keys().hasAll(['nome', 'projeto', 'horario', 'data', 'estado', 'obs', 'ordem'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80
        && textoAte(d, 'projeto', 80)
        && textoAte(d, 'horario', 5)
        && textoAte(d, 'data', 10)
        && textoAte(d, 'estado', 80)
        && textoAte(d, 'obs', 200)
        && d.ordem is number;
    }

    function contaValida(d) {
      return d.keys().hasOnly(['sal', 'hash']) && d.keys().hasAll(['sal', 'hash'])
        && d.sal is string && d.sal.size() >= 16 && d.sal.size() <= 64
        && d.hash is string && d.hash.size() >= 16 && d.hash.size() <= 64;
    }

    // Senha única do site: lê quem quiser; cria só se ainda não existe; nunca troca nem apaga.
    match /acesso/{id} {
      allow read: if id == 'senha';
      allow create: if id == 'senha' && contaValida(request.resource.data);
      allow update, delete: if false;
    }

    match /registros/{id} {
      allow read: if true;
      allow create, update: if id.size() <= 64 && registroValido(request.resource.data);
      allow delete: if true;
    }
  }
}
